# Single source of truth for every GKE service's live image tag (K8S-CD-01 Phase 2).
#
# Before this file existed, render.sh's own `${SHANKPIT_TAG:-v1}`-style fallbacks WERE the record
# of "what's actually deployed" -- so regenerating manifests for one service's new tag meant
# re-running the whole script, which would silently reset every OTHER service back to whatever
# literal default happened to be hand-typed into render.sh, unless a human remembered to also
# edit that line first. bump-tag.sh is now the only writer besides a deliberate manual release;
# render.sh sources this file before it renders anything.
#
# Values below are exactly what's live as of 2026-10-05 (read back from the committed manifests
# in clusters/prrject-fatbaby/*.yaml) -- this file is a snapshot, not a change.
COLLECTIONS_TAG=0.1.0
FATBABY_TAG=bfbb85a
RG_STABLE_TAG=3e55798
RG_RND_TAG=3e55798
GFD_TAG=1878f3b
SHANKPIT_TAG=8702fb7
IDUNA_TAG=bac2b2f
DEADWEIGHT_TAG=f88ff5a
DEADWEIGHT2_TAG=b1f5073
WOTAN_TAG=5c52086
TCP_EDGE_TAG=v4
EDGE_RELAY_TAG=4197389
GITOPS_SYNC_TAG=26a2991
GITOPS_AUTODEPLOY_TAG=e5e015b
CAREPYRE_TAG=v1
EINHORN_TAG=v1
MIXFORGE_TAG=3eef2ce
